{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b && npm run typecheck:core",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:csp": "playwright test --config playwright.csp.config.ts",
    "test:e2e:sync": "playwright test --config playwright.sync.config.ts",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "test:e2e:selection-qa": "tsc -p tsconfig.selection-qa-e2e.json && playwright test --config playwright.selection-qa.config.ts",
    "test:e2e:selection-qa-live": "tsc -p tsconfig.selection-qa-e2e.json && playwright test --config playwright.selection-qa-live.config.ts"
  },
  "dependencies": {
    "@readeverywhere/epub-core": "file:../packages/epub-core",
    "@types/node": "^25.5.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/compiler-sfc": "^3.5.32",
    "eventsource-client": "^1.2.0",
    "markdown-it": "^15.0.2",
    "sanitize-html": "^2.17.7",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/markdown-it": "^14.2.0",
    "@types/sanitize-html": "^2.16.1",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.27",
    "happy-dom": "^20.11.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "vitest": "^4.1.7"
  }
}
