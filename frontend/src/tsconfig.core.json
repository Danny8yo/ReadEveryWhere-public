{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["features/*/domain/**/*.ts", "features/*/model/**/*.ts", "shared/domain/**/*.ts", "shared/model/**/*.ts"]
}
