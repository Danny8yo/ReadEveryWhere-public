{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/features/*/domain/**/*.ts",
    "src/features/*/model/**/*.ts",
    "src/shared/domain/**/*.ts",
    "src/shared/utils/**/*.ts"
  ]
}
