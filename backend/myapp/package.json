{
  "name": "read-everywhere-server-prototype",
  "version": "1.0.0",
  "description": "UC-001 NestJS search prototype in src",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node --transpile-only -r tsconfig-paths/register src/main.ts",
    "inspect:book-document": "ts-node --transpile-only --project tools/book-document-inspector/tsconfig.json tools/book-document-inspector/server.ts",
    "inspect:book-document:typecheck": "tsc -p tools/book-document-inspector/tsconfig.json",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-ai-model-assets.mjs",
    "test": "jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/throttler": "^6.5.0",
    "@readeverywhere/epub-core": "file:../../packages/epub-core",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "better-sse": "0.16.1",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "5.2.1",
    "fast-xml-parser": "^5.7.3",
    "helmet": "^8.1.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.19",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
